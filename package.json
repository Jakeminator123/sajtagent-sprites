{
  "name": "sajtagent-sprites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "volta": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "check:contracts": "node scripts/verify-builder-contracts.mts && node scripts/verify-agent-session-contract.mts && tsc -p tsconfig.contracts.json",
    "check:agent-session": "node scripts/verify-agent-session-contract.mts && tsc -p tsconfig.agent-session.json",
    "check:runtime": "node scripts/verify-local-runtime.mts && tsc -p tsconfig.runtime.json",
    "dev:runtime": "node src/server.ts",
    "profile:materialize": "node scripts/materialize-openclaw-profile.mts"
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.8.1",
    "@openclaw/gateway-protocol": "2026.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "5.7.3"
  }
}
